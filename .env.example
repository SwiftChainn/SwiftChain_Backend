NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/swiftchain
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
LOG_LEVEL=debug

# Comma-separated list of allowed frontend origins. Use "*" to allow any origin (not recommended for production).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Max milliseconds to wait for in-flight HTTP, Socket.IO, and DB work
# before forcing process exit on SIGTERM/SIGINT (default: 30000).
SHUTDOWN_TIMEOUT_MS=30000

# ─── Stellar / Soroban ─────────────────────────────────────────────────────────
# Soroban RPC endpoint.
# Testnet  : https://soroban-testnet.stellar.org
# Mainnet  : https://soroban-mainnet.stellar.org (or a custom Horizon/RPC node)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase — must match SOROBAN_RPC_URL.
# Testnet  : Test SDF Network ; September 2015
# Mainnet  : Public Global Stellar Network ; September 2015
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Friendly alias used in logs/responses ("mainnet" | "testnet" | "futurenet")
STELLAR_NETWORK=testnet

# Request timeout (ms) for Soroban RPC calls. Default: 10000
SOROBAN_RPC_TIMEOUT_MS=10000

# ─── Evidence uploads ───────────────────────────────────────────────────────────
# Public base URL this API is reachable at — used to build local-storage file URLs.
APP_BASE_URL=http://localhost:3000

# Storage backend for uploaded evidence: "local" or "s3". Default: local
UPLOAD_STORAGE_DRIVER=local

# Directory (relative to project root) local-storage uploads are written to.
UPLOAD_LOCAL_DIR=uploads

# Maximum accepted evidence file size, in MB. Default: 10
UPLOAD_MAX_FILE_SIZE_MB=10

# Required when UPLOAD_STORAGE_DRIVER=s3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# How long (seconds) a signed S3 evidence URL remains valid. Default: 3600
AWS_S3_SIGNED_URL_EXPIRES_SECONDS=3600

# ─── Escrow indexer ─────────────────────────────────────────────────────────────
# Deployed escrow Soroban contract ID (the "C..." address) whose events the
# escrow indexer subscribes to.
ESCROW_CONTRACT_ID=

# Event topic emitted by the escrow contract when funds are locked.
# Default: escrow_funded
ESCROW_FUNDED_EVENT_TOPIC=escrow_funded

# ─── Circuit Breakers ────────────────────────────────────────────────────────────
# All thresholds follow opossum's semantics.  Tune per environment; defaults below
# are conservative values suitable for production.

# Google Maps Directions API circuit breaker
# % of calls that must fail within the rolling window before the circuit opens.
CB_GOOGLE_MAPS_ERROR_THRESHOLD_PERCENTAGE=50
# Rolling window duration (ms) used to compute the error rate.
CB_GOOGLE_MAPS_ROLLING_WINDOW_MS=30000
# How long (ms) the circuit stays OPEN before allowing a single test call.
CB_GOOGLE_MAPS_RESET_TIMEOUT_MS=60000
# Minimum calls in the window before the breaker is allowed to open.
CB_GOOGLE_MAPS_VOLUME_THRESHOLD=5
# Per-call timeout (ms).  Calls that exceed this are counted as failures.
CB_GOOGLE_MAPS_TIMEOUT_MS=10000

# Stellar / Soroban RPC circuit breaker
CB_SOROBAN_ERROR_THRESHOLD_PERCENTAGE=50
CB_SOROBAN_ROLLING_WINDOW_MS=30000
CB_SOROBAN_RESET_TIMEOUT_MS=60000
CB_SOROBAN_VOLUME_THRESHOLD=3
CB_SOROBAN_TIMEOUT_MS=15000
